rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Keep this list identical to the one in firestore.rules (UIDs only — public repo).
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'UfkvoyJj9Qco6RLQ6Tu0hcw9Ywi2'  // admin (email + password, nhecus back-office)
        ];
    }

    match /drawings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
