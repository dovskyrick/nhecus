rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin accounts allowed to edit: Firebase Auth UIDs only (this repo is PUBLIC — never emails).
    // The back-office header shows the signed-in UID. Keep identical to storage.rules.
    // Publish: Firebase console → Firestore → Rules, or `firebase deploy --only firestore:rules,storage`.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'REPLACE-WITH-ADMIN-UID'
        ];
    }

    match /drawings/{drawingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // site/collections (ordered list) and site/about
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
